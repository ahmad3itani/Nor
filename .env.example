# ─── Football API ────────────────────────────────────────────────────────────
# Get your key from https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=your_rapidapi_key_here
API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# ─── AI / OpenRouter ─────────────────────────────────────────────────────────
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Model to use for article rewriting (default: anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ─── Cron Security ───────────────────────────────────────────────────────────
# Used to protect /api/cron/* endpoints. Set a strong random string.
# Pass as:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-to-a-strong-random-string

# ─── n8n Webhook ─────────────────────────────────────────────────────────────
# Protects POST /api/n8n/publish  (used by your n8n workflow)
# Pass as:  Authorization: Bearer <N8N_WEBHOOK_SECRET>
# Or as query param: ?secret=<N8N_WEBHOOK_SECRET>
N8N_WEBHOOK_SECRET=change-me-to-a-strong-random-string

# ─── Database (Turso) ────────────────────────────────────────────────────────
# Local dev:  TURSO_DATABASE_URL=file:data/nor.db  (no auth token needed)
# Production: get from https://turso.tech → create database → get URL + token
TURSO_DATABASE_URL=file:data/nor.db
TURSO_AUTH_TOKEN=

# ─── Admin panel ─────────────────────────────────────────────────────────────
# Protects /admin/* pages and /api/admin/* routes
# Also set ADMIN_USER (default: "admin") and ADMIN_PASS for HTTP Basic Auth
ADMIN_SECRET=change-me-to-a-strong-random-string
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-strong-random-string

# ─── Site URL ────────────────────────────────────────────────────────────────
# Used in sitemap, robots.txt, JSON-LD, and OG metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME=نور
