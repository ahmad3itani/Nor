; Engine configuration file.
; Input map: every gameplay action needs keyboard AND controller bindings (enforced by tests/unit/test_input_map.gd).

config_version=5

[application]

config/name="REDLINE"
config/description="High-speed 2D pixel-art action platformer. M3 vertical slice + M4 playtest tooling + M5 world framework."
config/version="0.5.0-m5"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/EventBus.gd"
Settings="*res://autoload/Settings.gd"
Game="*res://autoload/Game.gd"
SaveManager="*res://autoload/SaveManager.gd"
AudioManager="*res://autoload/AudioManager.gd"
SceneRouter="*res://autoload/SceneRouter.gd"
InputGlyphs="*res://autoload/InputGlyphs.gd"
MusicDirector="*res://autoload/MusicDirector.gd"
Playtest="*res://autoload/Playtest.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=0

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=1

