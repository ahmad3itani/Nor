[input_devices]

pointing/emulate_touch_from_mouse=false

[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="one_way"
2d_physics/layer_4="enemy"
2d_physics/layer_5="hurtbox_player"
2d_physics/layer_6="hurtbox_enemy"
2d_physics/layer_7="hazard"
2d_physics/layer_8="interact"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=0.0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=false
environment/defaults/default_clear_color=Color(0.055, 0.047, 0.07, 1)
