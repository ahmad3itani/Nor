code_exempt = PackedStringArray("res://ui/debug/", "res://ui/menus/DevConsole.gd", "res://ui/menus/MomentMenu.gd", "res://ui/menus/SurveyMenu.gd", "res://devtools/", "res://playtest/", "res://tests/", "res://ui/menus/dev/", "res://devtools/dev_actions/")
