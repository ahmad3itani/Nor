[gd_resource type="Resource" script_class="L10nConfig" load_steps=2 format=3]

[ext_resource type="Script" path="res://l10n/L10nConfig.gd" id="1_cfg"]

[resource]
script = ExtResource("1_cfg")
resource_dirs = PackedStringArray("res://data")
scene_dirs = PackedStringArray("res://world/rooms", "res://bosses", "res://ui", "res://world/rooms/challenge")
