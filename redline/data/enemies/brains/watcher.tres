[gd_resource type="Resource" script_class="EnemyBrain" load_steps=9 format=3]

[ext_resource type="Script" path="res://enemies/modules/EnemyBrain.gd" id="brain"]
[ext_resource type="Script" path="res://enemies/modules/LookModule.gd" id="look_base"]
[ext_resource type="Script" path="res://enemies/modules/AttackRule.gd" id="attack_rule"]
[ext_resource type="Script" path="res://enemies/modules/LookEye.gd" id="look_eye"]
[ext_resource type="Script" path="res://enemies/modules/MoveHold.gd" id="move_hold"]

[sub_resource type="Resource" id="move"]
script = ExtResource("move_hold")

[sub_resource type="Resource" id="atk0"]
script = ExtResource("attack_rule")
max_range = 300.0
needs_line_of_sight = true
face_target = false

[sub_resource type="Resource" id="look0"]
script = ExtResource("look_eye")

[resource]
script = ExtResource("brain")
movement = SubResource("move")
attacks = Array[ExtResource("attack_rule")]([SubResource("atk0")])
looks = Array[ExtResource("look_base")]([SubResource("look0")])
