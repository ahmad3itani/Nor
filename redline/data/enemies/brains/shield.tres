[gd_resource type="Resource" script_class="EnemyBrain" load_steps=11 format=3]

[ext_resource type="Script" path="res://enemies/modules/EnemyBrain.gd" id="brain"]
[ext_resource type="Script" path="res://enemies/modules/LookModule.gd" id="look_base"]
[ext_resource type="Script" path="res://enemies/modules/AttackRule.gd" id="attack_rule"]
[ext_resource type="Script" path="res://enemies/modules/GuardFrontal.gd" id="guard_frontal"]
[ext_resource type="Script" path="res://enemies/modules/LookShieldPlate.gd" id="look_shield"]
[ext_resource type="Script" path="res://enemies/modules/MoveSlowTurn.gd" id="move_slow_turn"]

[sub_resource type="Resource" id="move"]
script = ExtResource("move_slow_turn")
turn_delay = 0.5
approach_until = 28.0

[sub_resource type="Resource" id="atk0"]
script = ExtResource("attack_rule")
