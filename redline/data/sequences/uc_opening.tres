[sub_resource type="Resource" id="Resource_uc_opening_00"]
script = ExtResource("3_fade")
to_alpha = 1.0
seconds = 0.0
label = "black"

[sub_resource type="Resource" id="Resource_uc_opening_01"]
script = ExtResource("4_rookpose")
pose = 1
label = "crouch on slab 14"

[sub_resource type="Resource" id="Resource_uc_opening_02"]
script = ExtResource("5_camera")
point = Vector2(176, -60)
seconds = 0.0
label = "frame the slab"

[sub_resource type="Resource" id="Resource_uc_opening_03"]
script = ExtResource("6_sfx")
id = &"heartbeat"
label = "heartbeat"

[sub_resource type="Resource" id="Resource_uc_opening_04"]
script = ExtResource("7_wait")
seconds = 0.7

[sub_resource type="Resource" id="Resource_uc_opening_05"]
script = ExtResource("6_sfx")
id = &"heartbeat"
label = "heartbeat"

[sub_resource type="Resource" id="Resource_uc_opening_06"]
script = ExtResource("7_wait")
seconds = 0.5

[sub_resource type="Resource" id="Resource_uc_opening_07"]
script = ExtResource("8_line")
speaker_id = "pa"
text = "Ward fourteen. Fourteen of fourteen processed."
label = "pa ward"

[sub_resource type="Resource" id="Resource_uc_opening_08"]
script = ExtResource("3_fade")
to_alpha = 0.0
seconds = 1.5
label = "fade in"
blocking = false

[sub_resource type="Resource" id="Resource_uc_opening_09"]
script = ExtResource("8_line")
speaker_id = "pa"
text = "Hold for collection."
label = "pa hold"

[sub_resource type="Resource" id="Resource_uc_opening_10"]
script = ExtResource("6_sfx")
id = &"heartbeat"
label = "core stirs"

[sub_resource type="Resource" id="Resource_uc_opening_11"]
script = ExtResource("9_actorflash")
