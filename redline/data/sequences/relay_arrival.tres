[sub_resource type="Resource" id="Resource_relay_arrival_05"]
script = ExtResource("3_camera")
point = Vector2(230, -120)
seconds = 1.2
label = "Orr"

[sub_resource type="Resource" id="Resource_relay_arrival_06"]
script = ExtResource("7_line")
