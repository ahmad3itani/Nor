[sub_resource type="Resource" id="Resource_relay_arrival_07"]
script = ExtResource("7_line")
speaker_id = "orr"
text = "Come on down. The kettle's still hot."
label = "orr come down"

[sub_resource type="Resource" id="Resource_relay_arrival_08"]
