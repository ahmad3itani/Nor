[gd_resource type="Resource" script_class="SequenceData" load_steps=22 format=3]

[ext_resource type="Script" path="res://cinematics/SequenceData.gd" id="1_seq"]
[ext_resource type="Script" path="res://cinematics/SequenceStep.gd" id="2_step"]
[ext_resource type="Script" path="res://cinematics/steps/SeqFade.gd" id="3_fade"]
[ext_resource type="Script" path="res://cinematics/steps/SeqMusic.gd" id="4_music"]
[ext_resource type="Script" path="res://cinematics/steps/SeqLine.gd" id="5_line"]
[ext_resource type="Script" path="res://cinematics/steps/SeqSfx.gd" id="6_sfx"]
[ext_resource type="Script" path="res://cinematics/steps/SeqMark.gd" id="7_mark"]
[ext_resource type="Script" path="res://cinematics/steps/SeqTitleCard.gd" id="8_title"]
[ext_resource type="Script" path="res://cinematics/steps/SeqCredits.gd" id="9_credits"]
[ext_resource type="Resource" path="res://data/endings/credits.tres" id="10_roll"]

[sub_resource type="Resource" id="Resource_ending_sever_00"]
script = ExtResource("3_fade")
to_alpha = 1.0
seconds = 0.0
label = "cover"

[sub_resource type="Resource" id="Resource_ending_sever_01"]
script = ExtResource("4_music")
state = 0
label = "silence"

[sub_resource type="Resource" id="Resource_ending_sever_02"]
script = ExtResource("5_line")
speaker_id = ""
text = "You tear the network down."
label = "narration"

[sub_resource type="Resource" id="Resource_ending_sever_03"]
script = ExtResource("6_sfx")
id = &"boss_slam"
label = "slam"

[sub_resource type="Resource" id="Resource_ending_sever_04"]
script = ExtResource("3_fade")
to_alpha = 0.6
seconds = 1.5
label = "grey frame"

[sub_resource type="Resource" id="Resource_ending_sever_05"]
script = ExtResource("5_line")
speaker_id = ""
text = "The lights go out district by district, all the way up the Spire."
label = "narration"

[sub_resource type="Resource" id="Resource_ending_sever_06"]
script = ExtResource("5_line")
speaker_id = "orr"
text = "Every band's dead. Quietest night Lowlight ever had."
label = "orr"
only_when = "atleast:arc_orr_stage:1"

[sub_resource type="Resource" id="Resource_ending_sever_07"]
script = ExtResource("5_line")
speaker_id = "mara"
text = "No lights, no Spire. We'll see what people build in the dark."
label = "mara"
only_when = "atleast:arc_mara_stage:1"

[sub_resource type="Resource" id="Resource_ending_sever_08"]
script = ExtResource("7_mark")
mark = "ending_sever_title"
label = "title mark"

[sub_resource type="Resource" id="Resource_ending_sever_09"]
script = ExtResource("8_title")
title = "SEVER"
subtitle = "PLACEHOLDER ENDING"
seconds = 2.5
label = "title card"

[sub_resource type="Resource" id="Resource_ending_sever_10"]
script = ExtResource("9_credits")
credits = ExtResource("10_roll")
mark = "ending_sever_credits"
label = "credits"

[resource]
script = ExtResource("1_seq")
id = "ending_sever"
room = ""
steps = Array[ExtResource("2_step")]([SubResource("Resource_ending_sever_00"), SubResource("Resource_ending_sever_01"), SubResource("Resource_ending_sever_02"), SubResource("Resource_ending_sever_03"), SubResource("Resource_ending_sever_04"), SubResource("Resource_ending_sever_05"), SubResource("Resource_ending_sever_06"), SubResource("Resource_ending_sever_07"), SubResource("Resource_ending_sever_08"), SubResource("Resource_ending_sever_09"), SubResource("Resource_ending_sever_10")])
seen_flag = "ending_seen_sever"
budget_seconds = 90.0
theatre_only = true
