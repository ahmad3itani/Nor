[sub_resource type="Resource" id="Resource_act1_close_00"]
script = ExtResource("3_camera")
point = Vector2(470, -150)
seconds = 1.6
label = "the trophy"

[sub_resource type="Resource" id="Resource_act1_close_01"]
script = ExtResource("4_mark")
mark = "act1_trophy"

[sub_resource type="Resource" id="Resource_act1_close_02"]
script = ExtResource("5_wait")
seconds = 0.6

[sub_resource type="Resource" id="Resource_act1_close_03"]
script = ExtResource("6_line")
speaker_id = "orr"
text = "Every band in Lowlight is saying it. Krail's tower went dark."
label = "orr on air"
only_when = "flag:dead_air_complete"

[sub_resource type="Resource" id="Resource_act1_close_04"]
script = ExtResource("6_line")
speaker_id = "orr"
text = "Half my board's deaf and I can still hear it. Krail's tower went dark."
label = "orr deaf board"
only_when = "!flag:dead_air_complete"

[sub_resource type="Resource" id="Resource_act1_close_05"]
script = ExtResource("6_line")
speaker_id = "mara"
text = "Then the Spire sends someone worse. It always does."
label = "mara"

[sub_resource type="Resource" id="Resource_act1_close_06"]
script = ExtResource("7_actorface")
actor = "Interactables/NPC_iko"
facing = -1
label = "Iko turns"
only_when = "flag:met_iko"

[sub_resource type="Resource" id="Resource_act1_close_07"]
script = ExtResource("6_line")
speaker_id = "iko"
text = "Worse pays better. Just saying."
label = "iko"
only_when = "flag:met_iko"

[sub_resource type="Resource" id="Resource_act1_close_08"]
script = ExtResource("8_sfx")
id = &"radio_static"
label = "static"

[sub_resource type="Resource" id="Resource_act1_close_09"]
script = ExtResource("6_line")
speaker_id = "band"
text = "...all Recovery units. Priority unchanged. Signature still active."
label = "band"

[sub_resource type="Resource" id="Resource_act1_close_10"]
script = ExtResource("8_sfx")
id = &"heartbeat"
label = "heartbeat"

[sub_resource type="Resource" id="Resource_act1_close_11"]
