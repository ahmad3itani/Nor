label = "silence"

[sub_resource type="Resource" id="Resource_ending_crown_02"]
script = ExtResource("5_line")
speaker_id = ""
text = "You take hold of the network. Every light in Veyra steadies at once."
label = "narration"

[sub_resource type="Resource" id="Resource_ending_crown_03"]
script = ExtResource("5_line")
speaker_id = ""
text = "The city runs through you now."
label = "narration"

[sub_resource type="Resource" id="Resource_ending_crown_04"]
script = ExtResource("5_line")
speaker_id = "nix"
text = "The map redraws itself every morning now. I don't touch it."
label = "nix"
only_when = "atleast:arc_nix_stage:1"

[sub_resource type="Resource" id="Resource_ending_crown_05"]
script = ExtResource("7_mark")
mark = "ending_crown_title"
label = "title mark"

[sub_resource type="Resource" id="Resource_ending_crown_06"]
