script = ExtResource("1")
id = "mf_lowlight_04"
title = "Cell Four"
text = "Rain through a crack in the ceiling. Someone in the next cell taps the pipe: three short, three long. A guard laughs. \"Save it. This one came in without a name. The tag just says SPIRE.\""
