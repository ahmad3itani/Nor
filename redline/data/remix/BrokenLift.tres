[gd_resource type="Resource" script_class="RoomRemix" load_steps=7 format=3]

[ext_resource type="Script" path="res://world/remix/RoomRemix.gd" id="RoomRemix"]
[ext_resource type="Script" path="res://world/remix/RemixOp.gd" id="RemixOp"]
[ext_resource type="Resource" path="res://data/enemies/needle_ledge_remix.tres" id="needle_ledge_remix"]

[sub_resource type="Resource" id="Op1"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Enemies/Needle1")
property = &"data"
value = ExtResource("needle_ledge_remix")

[sub_resource type="Resource" id="Op2"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Zones/Flow1")
property = &"drain_scale"
value = 1.0

[sub_resource type="Resource" id="Op3"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Zones/Flow1")
property = &"drain_floor"
value = 0.0

[resource]
script = ExtResource("RoomRemix")
room = "res://world/rooms/undercity/BrokenLift.tscn"
active_when = "flag:ng_remix"
ops = Array[ExtResource("RemixOp")]([SubResource("Op1"), SubResource("Op2"), SubResource("Op3")])
intent = "The teaching Flow Zone becomes a real zone."
