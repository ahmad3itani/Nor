[gd_resource type="Resource" script_class="RoomRemix" load_steps=12 format=3]

[ext_resource type="Script" path="res://world/remix/RoomRemix.gd" id="RoomRemix"]
[ext_resource type="Script" path="res://world/remix/RemixOp.gd" id="RemixOp"]
[ext_resource type="Resource" path="res://data/level/shutter_run_remix.tres" id="shutter_run_remix"]
[ext_resource type="Resource" path="res://data/level/shutter_l3_remix.tres" id="shutter_l3_remix"]
[ext_resource type="Resource" path="res://data/enemies/needle_remix.tres" id="needle_remix"]

[sub_resource type="Resource" id="Op1"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Geometry/Shutter_S2")
property = &"timing"
value = ExtResource("shutter_run_remix")

[sub_resource type="Resource" id="Op2"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Geometry/Shutter_S3")
property = &"timing"
value = ExtResource("shutter_run_remix")

[sub_resource type="Resource" id="Op3"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Geometry/Shutter_S4a")
property = &"timing"
value = ExtResource("shutter_l3_remix")

[sub_resource type="Resource" id="Op4"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Geometry/Shutter_S4b")
property = &"timing"
value = ExtResource("shutter_l3_remix")

[sub_resource type="Resource" id="Op5"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Enemies/Needle1")
property = &"data"
value = ExtResource("needle_remix")

[sub_resource type="Resource" id="Op6"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Enemies/Needle2")
property = &"data"
value = ExtResource("needle_remix")

[resource]
script = ExtResource("RoomRemix")
room = "res://world/rooms/lowlight/PowerBlock.tscn"
active_when = "flag:ng_remix"
ops = Array[ExtResource("RemixOp")]([SubResource("Op1"), SubResource("Op2"), SubResource("Op3"), SubResource("Op4"), SubResource("Op5"), SubResource("Op6")])
intent = "A tighter Grid on the same routes (shutter margins stay above the D-099 floor)."
