[gd_resource type="Resource" script_class="RoomRemix" load_steps=7 format=3]

[ext_resource type="Script" path="res://world/remix/RoomRemix.gd" id="RoomRemix"]
[ext_resource type="Script" path="res://world/remix/RemixOp.gd" id="RemixOp"]
[ext_resource type="Resource" path="res://data/level/shutter_run_remix.tres" id="shutter_run_remix"]
[ext_resource type="Resource" path="res://data/enemies/scout_drone_remix.tres" id="scout_drone_remix"]

[sub_resource type="Resource" id="Op1"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Geometry/Shutter_SR")
property = &"timing"
value = ExtResource("shutter_run_remix")

[sub_resource type="Resource" id="Op2"]
script = ExtResource("RemixOp")
kind = 0
target = NodePath("Enemies/ScoutDrone1")
scene_kind = "ScoutDrone"
data = ExtResource("scout_drone_remix")
offset = Vector2(120, -20)

[resource]
script = ExtResource("RoomRemix")
room = "res://world/rooms/lowlight/SmugglerRoute.tscn"
active_when = "flag:ng_remix"
ops = Array[ExtResource("RemixOp")]([SubResource("Op1"), SubResource("Op2")])
intent = "A quicker pump shutter and a second drone over the den."
