[gd_resource type="Resource" script_class="RoomRemix" load_steps=9 format=3]

[ext_resource type="Script" path="res://world/remix/RoomRemix.gd" id="RoomRemix"]
[ext_resource type="Script" path="res://world/remix/RemixOp.gd" id="RemixOp"]
[ext_resource type="Resource" path="res://data/enemies/enforcer_remix.tres" id="enforcer_remix"]
[ext_resource type="Resource" path="res://data/enemies/watcher_remix.tres" id="watcher_remix"]

[sub_resource type="Resource" id="Op1"]
script = ExtResource("RemixOp")
kind = 2
target = NodePath("Enemies/Needle2")
scene_kind = "Enforcer"
data = ExtResource("enforcer_remix")

[sub_resource type="Resource" id="Op2"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Enemies/Watcher1")
property = &"data"
value = ExtResource("watcher_remix")

[sub_resource type="Resource" id="Op3"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Enemies/Watcher2")
property = &"data"
value = ExtResource("watcher_remix")

[sub_resource type="Resource" id="Op4"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Enemies/Watcher3")
property = &"data"
value = ExtResource("watcher_remix")

[resource]
script = ExtResource("RoomRemix")
room = "res://world/rooms/lowlight/NeonRoofs.tscn"
active_when = "flag:ng_remix"
ops = Array[ExtResource("RemixOp")]([SubResource("Op1"), SubResource("Op2"), SubResource("Op3"), SubResource("Op4")])
intent = "An elite on the roofs, Watchers firing sooner."
