[gd_resource type="Resource" script_class="RoomRemix" load_steps=7 format=3]

[ext_resource type="Script" path="res://world/remix/RoomRemix.gd" id="RoomRemix"]
[ext_resource type="Script" path="res://world/remix/RemixOp.gd" id="RemixOp"]
[ext_resource type="Resource" path="res://data/enemies/needle_remix.tres" id="needle_remix"]
[ext_resource type="Resource" path="res://data/enemies/hopper_remix.tres" id="hopper_remix"]

[sub_resource type="Resource" id="Op1"]
script = ExtResource("RemixOp")
kind = 3
target = NodePath("Enemies/Needle3")
property = &"data"
value = ExtResource("needle_remix")

[sub_resource type="Resource" id="Op2"]
script = ExtResource("RemixOp")
kind = 2
target = NodePath("Enemies/Needle4")
scene_kind = "Hopper"
data = ExtResource("hopper_remix")

[resource]
script = ExtResource("RoomRemix")
room = "res://world/rooms/undercity/MedicalRuin.tscn"
active_when = "flag:ng_remix"
ops = Array[ExtResource("RemixOp")]([SubResource("Op1"), SubResource("Op2")])
intent = "The first fight already combines: a faster Needle and a Hopper. Needle1 stays the dormant practice dummy."
