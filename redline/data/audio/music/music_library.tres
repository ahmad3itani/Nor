"boss": 3.0,
"flow": 3.0,
"title": 6.0
}
boss_by_room = {}
extras = {}

[sub_resource type="Resource" id="Set_undercity"]
script = ExtResource("1_set")
district = &"undercity"
explore = "res://assets/audio/music/mus_undercity_explore.ogg"
