mix_db = -13.0

[sub_resource type="Resource" id="Set_lowlight"]
script = ExtResource("1_set")
district = &"lowlight"
explore = "res://assets/audio/music/mus_lowlight_explore.ogg"
aftermath_gain = 0.6
mix_db = -13.0

[resource]
script = ExtResource("2_lib")
