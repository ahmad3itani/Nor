[gd_resource type="Resource" script_class="MusicLibrary" load_steps=6 format=3]

[ext_resource type="Script" path="res://audio/MusicSet.gd" id="1_set"]
[ext_resource type="Script" path="res://audio/MusicLibrary.gd" id="2_lib"]

[sub_resource type="Resource" id="Set_default"]
script = ExtResource("1_set")
district = &""
title = "res://assets/audio/music/mus_title.ogg"
hub = "res://assets/audio/music/mus_relay.ogg"
flow = "res://assets/audio/music/mus_flow.ogg"
boss = "res://assets/audio/music/mus_boss.ogg"
