[gd_resource type="Resource" script_class="NpcProfile" load_steps=21 format=3]

[ext_resource type="Script" path="res://dialogue/NpcProfile.gd" id="profile"]
[ext_resource type="Script" path="res://dialogue/NpcDialogueRule.gd" id="rule"]
[ext_resource type="Script" path="res://dialogue/DialogueData.gd" id="dialogue"]
[ext_resource type="Script" path="res://dialogue/DialogueLine.gd" id="line"]

[sub_resource type="Resource" id="mara_after_boss_l0"]
script = ExtResource("line")
speaker = "Mara"
text = "Krail's dead and you're not. I'll take those odds every day."

[sub_resource type="Resource" id="mara_after_boss_l1"]
script = ExtResource("line")
speaker = "Mara"
text = "That dash module you pulled off him - don't let it pull you. What do you need?"

[sub_resource type="Resource" id="mara_after_boss"]
script = ExtResource("dialogue")
id = "mara_after_boss"
lines = Array[ExtResource("line")]([SubResource("mara_after_boss_l0"), SubResource("mara_after_boss_l1")])
open_menu = &"shop_mara"

[sub_resource type="Resource" id="rule_0"]
script = ExtResource("rule")
requires_flags = PackedStringArray("warden_krail_defeated")
dialogue = SubResource("mara_after_boss")

[sub_resource type="Resource" id="mara_intro_undercity_l0"]
script = ExtResource("line")
speaker = "Mara"
text = "Orr says you walked out of a Collector's nest with that thing still burning in you."

[sub_resource type="Resource" id="mara_intro_undercity_l1"]
script = ExtResource("line")
speaker = "Mara"
text = "You've felt it drink by now. Keep it fed, rest at Anchors, and it'll keep you running. Here. A Scattergun. Up close it solves arguments."

[sub_resource type="Resource" id="mara_intro_undercity"]
script = ExtResource("dialogue")
id = "mara_intro_undercity"
lines = Array[ExtResource("line")]([SubResource("mara_intro_undercity_l0"), SubResource("mara_intro_undercity_l1")])
set_flags = PackedStringArray("met_mara")
give_weapon = "scattergun"
open_menu = &"shop_mara"

[sub_resource type="Resource" id="rule_intro_undercity"]
script = ExtResource("rule")
requires_flags = PackedStringArray("collector_drone_defeated")
forbids_flags = PackedStringArray("met_mara")
dialogue = SubResource("mara_intro_undercity")

[sub_resource type="Resource" id="mara_intro_l0"]
script = ExtResource("line")
speaker = "Mara"
text = "Stop poking the scar. That's a Redline Core, and it is not supposed to be in a person."

[sub_resource type="Resource" id="mara_intro_l1"]
script = ExtResource("line")
speaker = "Mara"
text = "Out there it burns hot. Fight, move, break things - it drinks what's left and keeps you running."

[sub_resource type="Resource" id="mara_intro_l2"]
script = ExtResource("line")
speaker = "Mara"
text = "Rest at an Anchor and it settles. Here. A Scattergun. Up close it solves arguments."

[sub_resource type="Resource" id="mara_intro"]
script = ExtResource("dialogue")
id = "mara_intro"
lines = Array[ExtResource("line")]([SubResource("mara_intro_l0"), SubResource("mara_intro_l1"), SubResource("mara_intro_l2")])
set_flags = PackedStringArray("met_mara")
give_weapon = "scattergun"
open_menu = &"shop_mara"

[sub_resource type="Resource" id="rule_1"]
script = ExtResource("rule")
forbids_flags = PackedStringArray("met_mara")
dialogue = SubResource("mara_intro")

[sub_resource type="Resource" id="mara_shop_l0"]
script = ExtResource("line")
speaker = "Mara"
text = "Weapons, fixes, bad advice. Pick one."

[sub_resource type="Resource" id="mara_shop"]
script = ExtResource("dialogue")
id = "mara_shop"
lines = Array[ExtResource("line")]([SubResource("mara_shop_l0")])
open_menu = &"shop_mara"

[sub_resource type="Resource" id="rule_2"]
script = ExtResource("rule")
dialogue = SubResource("mara_shop")

[resource]
script = ExtResource("profile")
npc_id = "mara"
display_name = "Mara"
map_label = "Mechanic"
color = Color(0.78, 0.5, 0.38, 1)
rules = Array[ExtResource("rule")]([SubResource("rule_0"), SubResource("rule_intro_undercity"), SubResource("rule_1"), SubResource("rule_2")])
