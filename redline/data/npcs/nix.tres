[gd_resource type="Resource" script_class="NpcProfile" load_steps=20 format=3]

[ext_resource type="Script" path="res://dialogue/NpcProfile.gd" id="profile"]
[ext_resource type="Script" path="res://dialogue/NpcDialogueRule.gd" id="rule"]
[ext_resource type="Script" path="res://dialogue/DialogueData.gd" id="dialogue"]
[ext_resource type="Script" path="res://dialogue/DialogueLine.gd" id="line"]

[sub_resource type="Resource" id="nix_report_l0"]
script = ExtResource("line")
speaker = "Nix"
text = "You walked it. All of it, near enough. Look at that - the flood lines, the new walls."

[sub_resource type="Resource" id="nix_report_l1"]
script = ExtResource("line")
speaker = "Nix"
text = "Seventy years of Lowlight and nobody bothered to redraw it. Here. Your cut, and my old lens."

[sub_resource type="Resource" id="nix_report"]
script = ExtResource("dialogue")
id = "nix_report"
lines = Array[ExtResource("line")]([SubResource("nix_report_l0"), SubResource("nix_report_l1")])
set_flags = PackedStringArray("chart_lowlight_reported")
open_menu = &"shop_nix"

[sub_resource type="Resource" id="rule_0"]
script = ExtResource("rule")
requires_flags = PackedStringArray("map_charted_lowlight")
forbids_flags = PackedStringArray("chart_lowlight_reported")
dialogue = SubResource("nix_report")

[sub_resource type="Resource" id="nix_intro_l0"]
script = ExtResource("line")
speaker = "Nix"
text = "Nix. I draw the city. The city keeps redrawing itself, so it's steady work."

[sub_resource type="Resource" id="nix_intro_l1"]
script = ExtResource("line")
speaker = "Nix"
text = "Lowlight moved twice since the flood. My maps didn't. Walk it for me and I'll fill in the rest."

[sub_resource type="Resource" id="nix_intro_l2"]
script = ExtResource("line")
speaker = "Nix"
text = "Take a look at the stock. The transit pass gets you between Anchors you've rested at."

[sub_resource type="Resource" id="nix_intro"]
script = ExtResource("dialogue")
id = "nix_intro"
lines = Array[ExtResource("line")]([SubResource("nix_intro_l0"), SubResource("nix_intro_l1"), SubResource("nix_intro_l2")])
set_flags = PackedStringArray("met_nix", "quest_chart_started")
open_menu = &"shop_nix"

[sub_resource type="Resource" id="rule_1"]
script = ExtResource("rule")
forbids_flags = PackedStringArray("met_nix")
dialogue = SubResource("nix_intro")

[sub_resource type="Resource" id="nix_regular_l0"]
script = ExtResource("line")
speaker = "Nix"
text = "Back again. You're the only one here who looks at the map before they get lost."

[sub_resource type="Resource" id="nix_regular"]
script = ExtResource("dialogue")
id = "nix_regular"
lines = Array[ExtResource("line")]([SubResource("nix_regular_l0")])
open_menu = &"shop_nix"

[sub_resource type="Resource" id="rule_2"]
script = ExtResource("rule")
requires_conditions = PackedStringArray("atleast:talks_nix:4")
dialogue = SubResource("nix_regular")

[sub_resource type="Resource" id="nix_shop_l0"]
script = ExtResource("line")
speaker = "Nix"
text = "Maps, lenses, tickets. Everything a lost person needs."

[sub_resource type="Resource" id="nix_shop"]
script = ExtResource("dialogue")
id = "nix_shop"
lines = Array[ExtResource("line")]([SubResource("nix_shop_l0")])
open_menu = &"shop_nix"

[sub_resource type="Resource" id="rule_3"]
script = ExtResource("rule")
dialogue = SubResource("nix_shop")

[resource]
script = ExtResource("profile")
npc_id = "nix"
display_name = "Nix"
color = Color(0.45, 0.72, 0.62, 1)
map_label = "Cartographer"
rules = Array[ExtResource("rule")]([SubResource("rule_0"), SubResource("rule_1"), SubResource("rule_2"), SubResource("rule_3")])
