[gd_resource type="Resource" script_class="NpcProfile" load_steps=27 format=3]

[ext_resource type="Script" path="res://dialogue/NpcProfile.gd" id="profile"]
[ext_resource type="Script" path="res://dialogue/NpcDialogueRule.gd" id="rule"]
[ext_resource type="Script" path="res://dialogue/DialogueData.gd" id="dialogue"]
[ext_resource type="Script" path="res://dialogue/DialogueLine.gd" id="line"]
[ext_resource type="Resource" path="res://data/arcs/arc_orr.tres" id="arc_orr"]

[sub_resource type="Resource" id="orr_iko_l0"]
script = ExtResource("line")
speaker = "Orr"
text = "A smuggler came up the lift while you were out. Iko. Says you're good for business."

[sub_resource type="Resource" id="orr_iko"]
script = ExtResource("dialogue")
id = "orr_iko"
lines = Array[ExtResource("line")]([SubResource("orr_iko_l0")])
set_flags = PackedStringArray("met_iko")

[sub_resource type="Resource" id="rule_iko"]
script = ExtResource("rule")
requires_flags = PackedStringArray("warden_krail_defeated", "met_orr")
forbids_flags = PackedStringArray("met_iko")
dialogue = SubResource("orr_iko")

[sub_resource type="Resource" id="orr_rainline_l0"]
script = ExtResource("line")
speaker = "Orr"
text = "Somebody lit up the Rainline. My whole board just jumped."

[sub_resource type="Resource" id="orr_rainline"]
script = ExtResource("dialogue")
id = "orr_rainline"
lines = Array[ExtResource("line")]([SubResource("orr_rainline_l0")])
set_flags = PackedStringArray("orr_rainline_line")

[sub_resource type="Resource" id="rule_rainline"]
script = ExtResource("rule")
requires_flags = PackedStringArray("lowlight_power_rerouted", "met_orr")
forbids_flags = PackedStringArray("orr_rainline_line")
dialogue = SubResource("orr_rainline")

[sub_resource type="Resource" id="orr_report_l0"]
script = ExtResource("line")
speaker = "Orr"
text = "All three? The static's gone. I can hear Warden Krail's patrol codes clear as rain."

[sub_resource type="Resource" id="orr_report_l1"]
script = ExtResource("line")
speaker = "Orr"
text = "He's pulling something up the Bell Tower lift every night. Same crates they carried you out in."

[sub_resource type="Resource" id="orr_report_l2"]
script = ExtResource("line")
speaker = "Orr"
text = "Take this. Earned it. And Rook - don't go up that tower tired."

[sub_resource type="Resource" id="orr_report"]
script = ExtResource("dialogue")
id = "orr_report"
lines = Array[ExtResource("line")]([SubResource("orr_report_l0"), SubResource("orr_report_l1"), SubResource("orr_report_l2")])
set_flags = PackedStringArray("dead_air_reported")

[sub_resource type="Resource" id="rule_1"]
script = ExtResource("rule")
requires_flags = PackedStringArray("repeater_market", "repeater_stack", "repeater_bell", "met_orr")
forbids_flags = PackedStringArray("dead_air_reported")
dialogue = SubResource("orr_report")

[sub_resource type="Resource" id="orr_intro_undercity_l0"]
script = ExtResource("line")
speaker = "Orr"
text = "So you're the one who shut a Collector up. You look worse than I pictured."

[sub_resource type="Resource" id="orr_intro_undercity_l1"]
script = ExtResource("line")
speaker = "Orr"
text = "Mara wants a look at that Core. First, though: the Warden's people knocked our repeaters out of line."

[sub_resource type="Resource" id="orr_intro_undercity_l2"]
script = ExtResource("line")
speaker = "Orr"
text = "Lowlight's full of them. Realign three and this whole Relay stops being deaf. Deal?"

[sub_resource type="Resource" id="orr_intro_undercity"]
script = ExtResource("dialogue")
id = "orr_intro_undercity"
lines = Array[ExtResource("line")]([SubResource("orr_intro_undercity_l0"), SubResource("orr_intro_undercity_l1"), SubResource("orr_intro_undercity_l2")])
set_flags = PackedStringArray("quest_dead_air_started", "met_orr")

[sub_resource type="Resource" id="rule_intro_undercity"]
script = ExtResource("rule")
requires_flags = PackedStringArray("collector_drone_defeated")
forbids_flags = PackedStringArray("met_orr")
dialogue = SubResource("orr_intro_undercity")

[sub_resource type="Resource" id="orr_intro_l0"]
script = ExtResource("line")
speaker = "Orr"
text = "You're awake. Good. Mara said the thing in your chest would either restart you or cook the room."

[sub_resource type="Resource" id="orr_intro_l1"]
script = ExtResource("line")
speaker = "Orr"
text = "I run the radio. Or I did, before the Warden's people knocked our repeaters out of line."

[sub_resource type="Resource" id="orr_intro_l2"]
script = ExtResource("line")
speaker = "Orr"
text = "Lowlight's full of them. Realign three and this whole Relay stops being deaf. Deal?"

[sub_resource type="Resource" id="orr_intro"]
script = ExtResource("dialogue")
id = "orr_intro"
lines = Array[ExtResource("line")]([SubResource("orr_intro_l0"), SubResource("orr_intro_l1"), SubResource("orr_intro_l2")])
set_flags = PackedStringArray("quest_dead_air_started", "met_orr")

[sub_resource type="Resource" id="rule_3"]
script = ExtResource("rule")
dialogue = SubResource("orr_intro")

[resource]
script = ExtResource("profile")
npc_id = "orr"
display_name = "Orr"
map_label = "Radio"
color = Color(0.55, 0.62, 0.78, 1)
rules = Array[ExtResource("rule")]([SubResource("rule_iko"), SubResource("rule_rainline"), SubResource("rule_1"), SubResource("rule_intro_undercity"), SubResource("rule_3")])
arc = ExtResource("arc_orr")
