[gd_resource type="Resource" script_class="NpcProfile" load_steps=34 format=3]

[ext_resource type="Script" path="res://dialogue/NpcProfile.gd" id="profile"]
[ext_resource type="Script" path="res://dialogue/NpcDialogueRule.gd" id="rule"]
[ext_resource type="Script" path="res://dialogue/DialogueData.gd" id="dialogue"]
[ext_resource type="Script" path="res://dialogue/DialogueLine.gd" id="line"]

[sub_resource type="Resource" id="orr_radio_act1_l0"]
script = ExtResource("line")
speaker = "Orr"
text = "Relay here. Nothing on this band but Recovery now. Don't linger."

[sub_resource type="Resource" id="orr_radio_act1"]
script = ExtResource("dialogue")
id = "orr_radio_act1"
lines = Array[ExtResource("line")]([SubResource("orr_radio_act1_l0")])

[sub_resource type="Resource" id="rule_act1"]
script = ExtResource("rule")
requires_flags = PackedStringArray("act1_complete", "met_orr_radio")
dialogue = SubResource("orr_radio_act1")

[sub_resource type="Resource" id="orr_radio_after_l0"]
script = ExtResource("line")
speaker = "Radio"
text = "The Collector's gone off the band. Tell me that was you."

[sub_resource type="Resource" id="orr_radio_after_l1"]
script = ExtResource("line")
speaker = "Radio"
text = "Rail line's straight ahead. Top gallery, left side of the Relay. I'll leave the door unjammed."

[sub_resource type="Resource" id="orr_radio_after"]
script = ExtResource("dialogue")
id = "orr_radio_after"
lines = Array[ExtResource("line")]([SubResource("orr_radio_after_l0"), SubResource("orr_radio_after_l1")])
set_flags = PackedStringArray("orr_radio_after", "met_orr_radio")

[sub_resource type="Resource" id="rule_0"]
script = ExtResource("rule")
requires_flags = PackedStringArray("collector_drone_defeated")
forbids_flags = PackedStringArray("orr_radio_after")
dialogue = SubResource("orr_radio_after")

[sub_resource type="Resource" id="orr_radio_climb_l0"]
script = ExtResource("line")
speaker = "Radio"
text = "Top gallery. Keep climbing."

[sub_resource type="Resource" id="orr_radio_climb"]
script = ExtResource("dialogue")
id = "orr_radio_climb"
lines = Array[ExtResource("line")]([SubResource("orr_radio_climb_l0")])

[sub_resource type="Resource" id="rule_1"]
script = ExtResource("rule")
requires_flags = PackedStringArray("collector_drone_defeated")
dialogue = SubResource("orr_radio_climb")

[sub_resource type="Resource" id="orr_radio_legacy_l0"]
script = ExtResource("line")
speaker = "Orr"
text = "Orr, on the old crew band. You came down the back way? Then you know the voice."

[sub_resource type="Resource" id="orr_radio_legacy_l1"]
script = ExtResource("line")
speaker = "Orr"
text = "That bay below you is a Collector's nest. It hunts what's in your chest. Don't stand still near it."

[sub_resource type="Resource" id="orr_radio_legacy"]
script = ExtResource("dialogue")
id = "orr_radio_legacy"
lines = Array[ExtResource("line")]([SubResource("orr_radio_legacy_l0"), SubResource("orr_radio_legacy_l1")])
set_flags = PackedStringArray("met_orr_radio")

[sub_resource type="Resource" id="rule_2"]
script = ExtResource("rule")
requires_flags = PackedStringArray("met_orr")
forbids_flags = PackedStringArray("met_orr_radio")
dialogue = SubResource("orr_radio_legacy")

[sub_resource type="Resource" id="orr_radio_waiting_l0"]
script = ExtResource("line")
speaker = "Orr"
text = "Lift shaft, then the Anchor at the top, then the Collector's bay. Don't stop moving."

[sub_resource type="Resource" id="orr_radio_waiting"]
script = ExtResource("dialogue")
id = "orr_radio_waiting"
lines = Array[ExtResource("line")]([SubResource("orr_radio_waiting_l0")])

[sub_resource type="Resource" id="rule_3"]
script = ExtResource("rule")
requires_flags = PackedStringArray("met_orr_radio")
dialogue = SubResource("orr_radio_waiting")

[sub_resource type="Resource" id="orr_radio_shaft_l0"]
script = ExtResource("line")
speaker = "Radio"
text = "...is this band live? You by the lift shaft - don't answer. Just listen."

[sub_resource type="Resource" id="orr_radio_shaft_l1"]
script = ExtResource("line")
speaker = "Radio"
text = "That eye was a Collector. Civic Recovery. It doesn't want you. It wants what's in your chest."

[sub_resource type="Resource" id="orr_radio_shaft_l2"]
script = ExtResource("line")
speaker = "Radio"
text = "Up the shaft the Pulse runs thick and your Core drains. Keep moving, keep hitting. It feeds on that."

[sub_resource type="Resource" id="orr_radio_shaft_l3"]
script = ExtResource("line")
speaker = "Radio"
text = "There's an Anchor at the top - our kit. Rest there and fill back up. The only way on is through the bay. Its nest."

[sub_resource type="Resource" id="orr_radio_shaft_l4"]
script = ExtResource("line")
speaker = "Radio"
text = "Get past it and follow the old rail line up to the Relay. We're friendly. Mostly. Name's Orr."

[sub_resource type="Resource" id="orr_radio_shaft"]
script = ExtResource("dialogue")
id = "orr_radio_shaft"
lines = Array[ExtResource("line")]([SubResource("orr_radio_shaft_l0"), SubResource("orr_radio_shaft_l1"), SubResource("orr_radio_shaft_l2"), SubResource("orr_radio_shaft_l3"), SubResource("orr_radio_shaft_l4")])
set_flags = PackedStringArray("met_orr_radio")

[sub_resource type="Resource" id="rule_4"]
script = ExtResource("rule")
requires_flags = PackedStringArray("got_pulse_blade")
dialogue = SubResource("orr_radio_shaft")

[sub_resource type="Resource" id="orr_radio_first_l0"]
script = ExtResource("line")
speaker = "Radio"
text = "...is this band live? Don't answer. Just listen."

[sub_resource type="Resource" id="orr_radio_first_l1"]
script = ExtResource("line")
speaker = "Radio"
text = "Something down here hunts what's in your chest. Civic Recovery calls it a Collector. Its nest is the bay under the old rail line."

[sub_resource type="Resource" id="orr_radio_first_l2"]
script = ExtResource("line")
speaker = "Radio"
text = "The rail line runs up to the Relay. We're friendly. Mostly. Name's Orr."

[sub_resource type="Resource" id="orr_radio_first"]
script = ExtResource("dialogue")
id = "orr_radio_first"
lines = Array[ExtResource("line")]([SubResource("orr_radio_first_l0"), SubResource("orr_radio_first_l1"), SubResource("orr_radio_first_l2")])
set_flags = PackedStringArray("met_orr_radio")

[sub_resource type="Resource" id="rule_5"]
script = ExtResource("rule")
dialogue = SubResource("orr_radio_first")

[resource]
script = ExtResource("profile")
npc_id = "orr_radio"
display_name = "Radio"
map_label = "Radio"
color = Color(0.35, 0.88, 0.91, 1)
figure = false
verb = "Listen"
rules = Array[ExtResource("rule")]([SubResource("rule_act1"), SubResource("rule_0"), SubResource("rule_1"), SubResource("rule_2"), SubResource("rule_3"), SubResource("rule_4"), SubResource("rule_5")])
