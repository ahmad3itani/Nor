beat_rules = Array[ExtResource("rule")]([SubResource("r_seen_one_beat")])
optional = true

[resource]
script = ExtResource("arc")
npc_id = "mara"
stages = Array[ExtResource("stage")]([SubResource("stage_met"), SubResource("stage_krail")])
reactions = Array[ExtResource("stage")]([SubResource("reaction_eyes"), SubResource("reaction_seen_one")])
threads = PackedStringArray("thread_mara_core")
