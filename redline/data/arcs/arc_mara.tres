[gd_resource type="Resource" script_class="NpcArc" load_steps=33 format=3]

[ext_resource type="Script" path="res://dialogue/NpcArc.gd" id="arc"]
[ext_resource type="Script" path="res://dialogue/NpcArcStage.gd" id="stage"]
[ext_resource type="Script" path="res://dialogue/NpcDialogueRule.gd" id="rule"]
[ext_resource type="Script" path="res://dialogue/DialogueData.gd" id="dialogue"]
[ext_resource type="Script" path="res://dialogue/DialogueLine.gd" id="line"]
[ext_resource type="Script" path="res://dialogue/DialogueChoice.gd" id="choice"]

[sub_resource type="Resource" id="mara_idle_radio_l0"]
script = ExtResource("line")
speaker = "Mara"
text = "Orr's radio works again. Now he'll never stop talking. What do you need?"

[sub_resource type="Resource" id="mara_idle_radio"]
script = ExtResource("dialogue")
id = "mara_idle_radio"
lines = Array[ExtResource("line")]([SubResource("mara_idle_radio_l0")])
open_menu = &"shop_mara"

[sub_resource type="Resource" id="s_met_idle_radio"]
script = ExtResource("rule")
requires_flags = PackedStringArray("dead_air_complete")
dialogue = SubResource("mara_idle_radio")

[sub_resource type="Resource" id="stage_met"]
script = ExtResource("stage")
id = "met"
enter_all = PackedStringArray("flag:met_mara")
idle_rules = Array[ExtResource("rule")]([SubResource("s_met_idle_radio")])
journal_note = "Mechanic. Knows what the Core is. Won't say how she knows."

[sub_resource type="Resource" id="mara_after_boss_l0"]
script = ExtResource("line")
speaker = "Mara"
text = "Krail's dead and you're not. I'll take those odds every day."

[sub_resource type="Resource" id="mara_after_boss_l1"]
script = ExtResource("line")
speaker = "Mara"
text = "That dash module you pulled off him - don't let it pull you."

[sub_resource type="Resource" id="mara_after_boss_l2"]
script = ExtResource("line")
speaker = "Mara"
text = "When you're steady, I want that Core on my bench. Just a look."

[sub_resource type="Resource" id="mara_after_boss"]
script = ExtResource("dialogue")
id = "mara_after_boss"
lines = Array[ExtResource("line")]([SubResource("mara_after_boss_l0"), SubResource("mara_after_boss_l1"), SubResource("mara_after_boss_l2")])
set_flags = PackedStringArray("arcbeat_mara_krail", "thread_mara_core")
open_menu = &"shop_mara"

[sub_resource type="Resource" id="s_krail_beat"]
script = ExtResource("rule")
dialogue = SubResource("mara_after_boss")

[sub_resource type="Resource" id="mara_idle_told_l0"]
script = ExtResource("line")
speaker = "Mara"
text = "What I told you stays at this bench. Now, what do you need?"

[sub_resource type="Resource" id="mara_idle_told"]
script = ExtResource("dialogue")
id = "mara_idle_told"
lines = Array[ExtResource("line")]([SubResource("mara_idle_told_l0")])
open_menu = &"shop_mara"

[sub_resource type="Resource" id="mara_idle_bench_l0"]
script = ExtResource("line")
speaker = "Mara"
text = "Bench is clear whenever you are. Until then: weapons, fixes."

[sub_resource type="Resource" id="mara_idle_bench"]
script = ExtResource("dialogue")
id = "mara_idle_bench"
lines = Array[ExtResource("line")]([SubResource("mara_idle_bench_l0")])
open_menu = &"shop_mara"

[sub_resource type="Resource" id="s_krail_idle_told"]
script = ExtResource("rule")
requires_flags = PackedStringArray("bond_mara_told")
dialogue = SubResource("mara_idle_told")

[sub_resource type="Resource" id="s_krail_idle_bench"]
script = ExtResource("rule")
dialogue = SubResource("mara_idle_bench")

[sub_resource type="Resource" id="stage_krail"]
script = ExtResource("stage")
id = "krail"
enter_all = PackedStringArray("flag:warden_krail_defeated")
beat_rules = Array[ExtResource("rule")]([SubResource("s_krail_beat")])
idle_rules = Array[ExtResource("rule")]([SubResource("s_krail_idle_told"), SubResource("s_krail_idle_bench")])
journal_note = "Wants the Core on her bench. Just a look, she says."

[sub_resource type="Resource" id="mara_eyes_l0"]
script = ExtResource("line")
speaker = "Mara"
text = "You keep drifting off mid-sentence. Where do you go?"

[sub_resource type="Resource" id="mara_eyes_l1"]
script = ExtResource("line")
speaker = "Mara"
text = "If you start seeing things, tell me. Not Orr. Me."

[sub_resource type="Resource" id="mara_eyes"]
script = ExtResource("dialogue")
id = "mara_eyes"
lines = Array[ExtResource("line")]([SubResource("mara_eyes_l0"), SubResource("mara_eyes_l1")])
set_flags = PackedStringArray("arcbeat_mara_eyes")
open_menu = &"shop_mara"

[sub_resource type="Resource" id="r_eyes_beat"]
script = ExtResource("rule")
dialogue = SubResource("mara_eyes")

[sub_resource type="Resource" id="reaction_eyes"]
script = ExtResource("stage")
id = "eyes"
enter_all = PackedStringArray("atleast:memories_remembered:1")
min_stage = 1
beat_rules = Array[ExtResource("rule")]([SubResource("r_eyes_beat")])

[sub_resource type="Resource" id="mara_seen_one_l0"]
script = ExtResource("line")
speaker = "Mara"
text = "Hold still. That scar's careful stitching. Somebody wanted you to live."

[sub_resource type="Resource" id="mara_seen_one_l1"]
script = ExtResource("line")
speaker = "Mara"
text = "I've seen one of these Cores before. Once. It wasn't in a person then."

[sub_resource type="Resource" id="mara_seen_one"]
script = ExtResource("dialogue")
id = "mara_seen_one"
lines = Array[ExtResource("line")]([SubResource("mara_seen_one_l0"), SubResource("mara_seen_one_l1")])
set_flags = PackedStringArray("arcbeat_mara_seen_one", "bond_mara_told")
open_menu = &"shop_mara"

[sub_resource type="Resource" id="r_seen_one_beat"]
script = ExtResource("rule")
dialogue = SubResource("mara_seen_one")

[sub_resource type="Resource" id="reaction_seen_one"]
script = ExtResource("stage")
