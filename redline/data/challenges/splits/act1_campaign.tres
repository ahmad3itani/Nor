[gd_resource type="Resource" script_class="SplitList" load_steps=10 format=3]

[ext_resource type="Script" path="res://challenges/SplitList.gd" id="1_list"]
[ext_resource type="Script" path="res://challenges/SplitDef.gd" id="2_def"]

[sub_resource type="Resource" id="Resource_uc_blade"]
script = ExtResource("2_def")
id = "uc_blade"
label = "Pulse Blade"
when = "flag:got_pulse_blade"

[sub_resource type="Resource" id="Resource_uc_collector"]
script = ExtResource("2_def")
id = "uc_collector"
label = "Collector Drone"
when = "flag:collector_drone_defeated"

[sub_resource type="Resource" id="Resource_uc_relay"]
script = ExtResource("2_def")
id = "uc_relay"
label = "The Relay"
room = "res://world/rooms/lowlight/Relay.tscn"

[sub_resource type="Resource" id="Resource_ll_power"]
script = ExtResource("2_def")
id = "ll_power"
label = "Power rerouted"
when = "flag:lowlight_power_rerouted"

[sub_resource type="Resource" id="Resource_ll_rainline"]
script = ExtResource("2_def")
id = "ll_rainline"
label = "Rainline"
when = "flag:chase_rainline_done"

[sub_resource type="Resource" id="Resource_ll_krail"]
script = ExtResource("2_def")
id = "ll_krail"
label = "Warden Krail"
when = "flag:warden_krail_defeated"

[sub_resource type="Resource" id="Resource_act1_end"]
script = ExtResource("2_def")
id = "act1_end"
label = "Act I"
when = "flag:act1_complete"

[resource]
script = ExtResource("1_list")
splits = Array[ExtResource("2_def")]([SubResource("Resource_uc_blade"), SubResource("Resource_uc_collector"), SubResource("Resource_uc_relay"), SubResource("Resource_ll_power"), SubResource("Resource_ll_rainline"), SubResource("Resource_ll_krail"), SubResource("Resource_act1_end")])
auto_room_splits = true
