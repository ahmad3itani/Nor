#. SeqLine · speaker: orr
#. max 120 chars
#: data/sequences/act1_close.tres
msgid "Every band in Lowlight is saying it. Krail's tower went dark."
msgstr ""

#. key: data/sequences/act1_close.tres::steps[4].text
#. SeqLine · speaker: orr
#. max 120 chars
#: data/sequences/act1_close.tres
msgid "Half my board's deaf and I can still hear it. Krail's tower went dark."
msgstr ""

#. key: data/sequences/act1_close.tres::steps[5].text
#. SeqLine · speaker: mara
#. max 120 chars
#: data/sequences/act1_close.tres
msgid "Then the Spire sends someone worse. It always does."
msgstr ""

#. key: data/sequences/act1_close.tres::steps[7].text
#. SeqLine · speaker: iko
#. max 120 chars
#: data/sequences/act1_close.tres
msgid "Worse pays better. Just saying."
msgstr ""

#. key: data/sequences/act1_close.tres::steps[9].text
#. SeqLine · speaker: band
#. max 120 chars
#: data/sequences/act1_close.tres
msgid "...all Recovery units. Priority unchanged. Signature still active."
msgstr ""

#. key: data/sequences/bark_bell_lift.tres::steps[0].text
#. SeqLine · speaker: band
#. max 120 chars
#: data/sequences/bark_bell_lift.tres
msgid "Lift crew, tonight's load is priority. The Warden signs for it himself."
msgstr ""

#. key: data/sequences/bark_market_patrol.tres::steps[0].text
#. SeqLine · speaker: band
#. max 120 chars
#: data/sequences/bark_market_patrol.tres
msgid "...patrol eight, Market Run. Scanning for a core signature. No name on file."
msgstr ""

#. key: data/sequences/bark_tunnel_orr.tres::steps[0].text
#. SeqLine · speaker: orr
#. max 120 chars
#: data/sequences/bark_tunnel_orr.tres
