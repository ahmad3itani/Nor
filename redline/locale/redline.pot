#. max 48 chars
#: data/sequences/ending_crown.tres data/sequences/ending_redline.tres data/sequences/ending_release.tres data/sequences/ending_sever.tres
msgid "PLACEHOLDER ENDING"
msgstr ""

#. key: data/sequences/ending_redline.tres::steps[3].text
#. SeqLine
#. max 120 chars
#: data/sequences/ending_redline.tres
msgid "Static on every band at once."
msgstr ""

#. key: data/sequences/ending_redline.tres::steps[4].text
#. SeqLine
#. max 120 chars
#: data/sequences/ending_redline.tres
msgid "Then everything goes red, and quiet."
msgstr ""

#. key: data/sequences/ending_release.tres::steps[2].text
#. SeqLine
#. max 120 chars
#: data/sequences/ending_release.tres
msgid "You don't pull and you don't hold. You change it."
msgstr ""

#. key: data/sequences/ending_release.tres::steps[3].text
#. SeqLine
#. max 120 chars
#: data/sequences/ending_release.tres
msgid "The lights stay on."
msgstr ""

#. key: data/sequences/ending_release.tres::steps[4].text
#. SeqLine
#. max 120 chars
#: data/sequences/ending_release.tres
msgid "Three short. Three long. This time the tapping finishes."
msgstr ""

#. key: data/sequences/ending_release.tres::steps[5].text
#. SeqLine · speaker: mara
#. max 120 chars
#: data/sequences/ending_release.tres
msgid "You came back. That's new."
msgstr ""

#. key: data/sequences/ending_release.tres::steps[6].text
#. SeqLine · speaker: vell
#. max 120 chars
#: data/sequences/ending_release.tres
msgid "Relay's full. First time I've had to turn the heat up."
msgstr ""

#. key: data/sequences/ending_sever.tres::steps[2].text
#. SeqLine
#. max 120 chars
#: data/sequences/ending_sever.tres
msgid "You tear the network down."
msgstr ""

#. key: data/sequences/ending_sever.tres::steps[5].text
#. SeqLine
#. max 120 chars
#: data/sequences/ending_sever.tres
msgid "The lights go out district by district, all the way up the Spire."
msgstr ""

#. key: data/sequences/ending_sever.tres::steps[6].text
#. SeqLine · speaker: orr
#. max 120 chars
#: data/sequences/ending_sever.tres
msgid "Every band's dead. Quietest night Lowlight ever had."
msgstr ""

#. key: data/sequences/ending_sever.tres::steps[7].text
#. SeqLine · speaker: mara
#. max 120 chars
#: data/sequences/ending_sever.tres
msgid "No lights, no Spire. We'll see what people build in the dark."
msgstr ""

