#. DialogueLine · speaker: Iko
#. max 160 chars
#: data/arcs/arc_iko.tres
msgid "Krail's gone, so his trucks are mine now. Most of the crates, anyway."
msgstr ""

#. key: data/arcs/arc_iko.tres::stages[1].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Iko
#. max 160 chars
#: data/arcs/arc_iko.tres
msgid "The ones tagged SPIRE stay shut. Rule of the trade: the Spire always comes to collect."
msgstr ""

#. key: data/arcs/arc_iko.tres::stages[1].idle_rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Iko
#. max 160 chars
#: data/arcs/arc_iko.tres
msgid "Spire crates stay shut. Everything else is for sale."
msgstr ""

#. key: data/arcs/arc_iko.tres::reactions[0].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Iko
#. max 160 chars
#: data/arcs/arc_iko.tres
msgid "Somebody cracked the back wall of my den. Heavy hands."
msgstr ""

#. key: data/arcs/arc_iko.tres::reactions[0].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Iko
#. max 160 chars
#: data/arcs/arc_iko.tres
msgid "Keep what you found. Call it rent on the Relay."
msgstr ""

#. key: data/arcs/arc_mara.tres::stages[0].journal_note
#. NpcArcStage
#. max 90 chars
#: data/arcs/arc_mara.tres
msgid "Mechanic. Knows what the Core is. Won't say how she knows."
msgstr ""

#. key: data/arcs/arc_mara.tres::reactions[0].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_mara.tres::reactions[0].beat_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_mara.tres::reactions[1].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_mara.tres::reactions[1].beat_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_mara.tres::stages[0].idle_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_mara.tres::stages[1].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_mara.tres::stages[1].beat_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_mara.tres::stages[1].beat_rules[0].dialogue.lines[2].speaker
#. key: data/arcs/arc_mara.tres::stages[1].idle_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_mara.tres::stages[1].idle_rules[1].dialogue.lines[0].speaker
#. key: data/npcs/mara.tres::display_name
#. key: data/npcs/mara.tres::rules[0].dialogue.lines[0].speaker
#. key: data/npcs/mara.tres::rules[0].dialogue.lines[1].speaker
#. key: data/npcs/mara.tres::rules[1].dialogue.lines[0].speaker
#. key: data/npcs/mara.tres::rules[1].dialogue.lines[1].speaker
#. key: data/npcs/mara.tres::rules[1].dialogue.lines[2].speaker
#. key: data/npcs/mara.tres::rules[2].dialogue.lines[0].speaker
#. DialogueLine · speaker: Mara
#. NpcProfile
#. max 24 chars
#: data/arcs/arc_mara.tres data/npcs/mara.tres
msgid "Mara"
msgstr ""

#. key: data/arcs/arc_mara.tres::stages[0].idle_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/arcs/arc_mara.tres
msgid "Orr's radio works again. Now he'll never stop talking. What do you need?"
msgstr ""

#. key: data/arcs/arc_mara.tres::stages[1].journal_note
#. NpcArcStage
#. max 90 chars
#: data/arcs/arc_mara.tres
msgid "Wants the Core on her bench. Just a look, she says."
msgstr ""

#. key: data/arcs/arc_mara.tres::stages[1].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/arcs/arc_mara.tres
msgid "Krail's dead and you're not. I'll take those odds every day."
msgstr ""

#. key: data/arcs/arc_mara.tres::stages[1].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/arcs/arc_mara.tres
msgid "That dash module you pulled off him - don't let it pull you."
msgstr ""

#. key: data/arcs/arc_mara.tres::stages[1].beat_rules[0].dialogue.lines[2].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/arcs/arc_mara.tres
msgid "When you're steady, I want that Core on my bench. Just a look."
msgstr ""

#. key: data/arcs/arc_mara.tres::stages[1].idle_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/arcs/arc_mara.tres
msgid "What I told you stays at this bench. Now, what do you need?"
msgstr ""

#. key: data/arcs/arc_mara.tres::stages[1].idle_rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/arcs/arc_mara.tres
msgid "Bench is clear whenever you are. Until then: weapons, fixes."
msgstr ""

#. key: data/arcs/arc_mara.tres::reactions[0].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/arcs/arc_mara.tres
msgid "You keep drifting off mid-sentence. Where do you go?"
msgstr ""

#. key: data/arcs/arc_mara.tres::reactions[0].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/arcs/arc_mara.tres
msgid "If you start seeing things, tell me. Not Orr. Me."
msgstr ""

#. key: data/arcs/arc_mara.tres::reactions[1].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/arcs/arc_mara.tres
msgid "Hold still. That scar's careful stitching. Somebody wanted you to live."
msgstr ""

#. key: data/arcs/arc_mara.tres::reactions[1].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/arcs/arc_mara.tres
msgid "I've seen one of these Cores before. Once. It wasn't in a person then."
msgstr ""

#. key: data/arcs/arc_nix.tres::stages[0].journal_note
#. NpcArcStage
#. max 90 chars
#: data/arcs/arc_nix.tres
msgid "Cartographer. The city keeps moving. Nix keeps up."
msgstr ""

#. key: data/arcs/arc_nix.tres::reactions[0].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_nix.tres::reactions[0].beat_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_nix.tres::reactions[1].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_nix.tres::reactions[1].beat_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_nix.tres::stages[0].idle_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_nix.tres::stages[0].idle_rules[1].dialogue.lines[0].speaker
#. key: data/arcs/arc_nix.tres::stages[0].idle_rules[2].dialogue.lines[0].speaker
#. key: data/arcs/arc_nix.tres::stages[1].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_nix.tres::stages[1].beat_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_nix.tres::stages[1].idle_rules[1].dialogue.lines[0].speaker
#. key: data/npcs/nix.tres::display_name
#. key: data/npcs/nix.tres::rules[0].dialogue.lines[0].speaker
#. key: data/npcs/nix.tres::rules[0].dialogue.lines[1].speaker
#. key: data/npcs/nix.tres::rules[1].dialogue.lines[0].speaker
#. key: data/npcs/nix.tres::rules[1].dialogue.lines[1].speaker
#. key: data/npcs/nix.tres::rules[1].dialogue.lines[2].speaker
#. key: data/npcs/nix.tres::rules[2].dialogue.lines[0].speaker
#. key: data/quests/chart_lowlight.tres::giver
#. key: data/quests/chart_lowlight.tres::stages[1].map_note
#. DialogueLine · speaker: Nix
#. NpcProfile
#. QuestData
#. QuestStage
#. max 24 chars
#: data/arcs/arc_nix.tres data/npcs/nix.tres data/quests/chart_lowlight.tres
msgid "Nix"
msgstr ""

#. key: data/arcs/arc_nix.tres::stages[0].idle_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/arcs/arc_nix.tres
msgid "My map's better than the Wardens' now. Don't tell them."
msgstr ""

#. key: data/arcs/arc_nix.tres::stages[0].idle_rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/arcs/arc_nix.tres
msgid "Found me another room? Tell me where. I'll pretend I knew."
msgstr ""

#. key: data/arcs/arc_nix.tres::stages[0].idle_rules[2].dialogue.lines[0].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/arcs/arc_nix.tres
msgid "Back again. You're the only one here who looks at the map before they get lost."
msgstr ""

#. key: data/arcs/arc_nix.tres::stages[1].journal_note
#. NpcArcStage
#. max 90 chars
#: data/arcs/arc_nix.tres
msgid "Warden Tower is on every map. Nix wants to know who draws them."
msgstr ""

#. key: data/arcs/arc_nix.tres::stages[1].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/arcs/arc_nix.tres
msgid "Warden Tower is on every map I own. Official ones too. Nothing else in Lowlight holds still."
msgstr ""

#. key: data/arcs/arc_nix.tres::stages[1].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/arcs/arc_nix.tres
msgid "Someone upstairs wants it found. I'd like to know who draws their maps."
msgstr ""

#. key: data/arcs/arc_nix.tres::stages[1].idle_rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/arcs/arc_nix.tres
msgid "Still thinking about that tower. Maps, lenses, tickets?"
msgstr ""

#. key: data/arcs/arc_nix.tres::reactions[0].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/arcs/arc_nix.tres
msgid "You keep finding rooms I never drew. That's either a gift or a bad habit."
msgstr ""

#. key: data/arcs/arc_nix.tres::reactions[0].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/arcs/arc_nix.tres
msgid "Tell me where they are. I'll pretend I knew."
msgstr ""

#. key: data/arcs/arc_nix.tres::reactions[1].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/arcs/arc_nix.tres
msgid "Heard Krail kept books. Books mean someone reads them."
msgstr ""

#. key: data/arcs/arc_nix.tres::reactions[1].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/arcs/arc_nix.tres
msgid "Maps and ledgers. Somewhere upstairs, they end up on the same desk."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[0].journal_note
#. NpcArcStage
#. max 90 chars
#: data/arcs/arc_orr.tres
msgid "Radio. Hears everything in Lowlight, repeats most of it."
msgstr ""

#. key: data/arcs/arc_orr.tres::reactions[0].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_orr.tres::reactions[0].beat_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_orr.tres::stages[0].idle_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_orr.tres::stages[0].idle_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_orr.tres::stages[0].idle_rules[1].dialogue.lines[0].speaker
#. key: data/arcs/arc_orr.tres::stages[0].idle_rules[1].dialogue.lines[1].speaker
#. key: data/arcs/arc_orr.tres::stages[1].beat_rules[0].dialogue.choices[0].reply[0].speaker
#. key: data/arcs/arc_orr.tres::stages[1].beat_rules[0].dialogue.choices[1].reply[0].speaker
#. key: data/arcs/arc_orr.tres::stages[1].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_orr.tres::stages[1].beat_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_orr.tres::stages[1].idle_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_orr.tres::stages[1].idle_rules[1].dialogue.lines[0].speaker
#. key: data/npcs/orr.tres::display_name
#. key: data/npcs/orr.tres::rules[0].dialogue.lines[0].speaker
#. key: data/npcs/orr.tres::rules[1].dialogue.lines[0].speaker
#. key: data/npcs/orr.tres::rules[2].dialogue.lines[0].speaker
#. key: data/npcs/orr.tres::rules[2].dialogue.lines[1].speaker
#. key: data/npcs/orr.tres::rules[2].dialogue.lines[2].speaker
#. key: data/npcs/orr.tres::rules[3].dialogue.lines[0].speaker
#. key: data/npcs/orr.tres::rules[3].dialogue.lines[1].speaker
#. key: data/npcs/orr.tres::rules[3].dialogue.lines[2].speaker
#. key: data/npcs/orr.tres::rules[4].dialogue.lines[0].speaker
#. key: data/npcs/orr.tres::rules[4].dialogue.lines[1].speaker
#. key: data/npcs/orr.tres::rules[4].dialogue.lines[2].speaker
#. key: data/npcs/orr_radio.tres::rules[0].dialogue.lines[0].speaker
#. key: data/npcs/orr_radio.tres::rules[3].dialogue.lines[0].speaker
#. key: data/npcs/orr_radio.tres::rules[3].dialogue.lines[1].speaker
#. key: data/npcs/orr_radio.tres::rules[4].dialogue.lines[0].speaker
#. key: data/quests/dead_air.tres::giver
#. key: data/quests/dead_air.tres::stages[1].map_note
#. DialogueLine · speaker: Orr
#. NpcProfile
#. QuestData
#. QuestStage
#. max 24 chars
#: data/arcs/arc_orr.tres data/npcs/orr.tres data/npcs/orr_radio.tres data/quests/dead_air.tres
msgid "Orr"
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[0].idle_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "Hear that? Lowlight's talking again. Rumors, patrol chatter, somebody singing badly on a rooftop."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[0].idle_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "Every voice out there is a direction. You bring me more antennas, I'll bring you more city."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[0].idle_rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "Three repeaters. One on the Market roofs, one inside the Apartment Stack, one on the Bell Tower."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[0].idle_rules[1].dialogue.lines[1].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "They're old. Hit them with your shoulder if you have to. Hit them gently."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[1].journal_note
#. NpcArcStage
#. max 90 chars
#: data/arcs/arc_orr.tres
msgid "Krail's dead. Orr asked what Lowlight should hear."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[1].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "Krail's patrol band is still dead. Lowlight's already guessing who."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[1].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "I can tell Lowlight it was you. Or I let them keep guessing. Your call."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[1].beat_rules[0].dialogue.choices[0].label
#. DialogueChoice
#. max 48 chars
#: data/arcs/arc_orr.tres
msgid "Put it on the air."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[1].beat_rules[0].dialogue.choices[0].reply[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "Then Lowlight knows it was you. So do the Wardens."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[1].beat_rules[0].dialogue.choices[1].label
#. DialogueChoice
#. max 48 chars
#: data/arcs/arc_orr.tres
msgid "Let them guess."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[1].beat_rules[0].dialogue.choices[1].reply[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "A ghost, then. Ghosts get rumors, not posters."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[1].idle_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "Every Warden band has your description now. Keep moving."
msgstr ""

#. key: data/arcs/arc_orr.tres::stages[1].idle_rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "Latest rumor: Krail slipped off his own tower. Nobody believes it."
msgstr ""

#. key: data/arcs/arc_orr.tres::reactions[0].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "Board picked up tapping on an old pipe line. Three short, three long."
msgstr ""

#. key: data/arcs/arc_orr.tres::reactions[0].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/arcs/arc_orr.tres
msgid "Old crew call sign. Means 'still here'. Haven't heard it in years."
msgstr ""

#. key: data/arcs/arc_vell.tres::stages[0].journal_note
#. NpcArcStage
#. max 90 chars
#: data/arcs/arc_vell.tres
msgid "Circuit broker. Sells lies to the Core, at a markup."
msgstr ""

#. key: data/arcs/arc_vell.tres::reactions[0].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_vell.tres::reactions[0].beat_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_vell.tres::reactions[1].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_vell.tres::reactions[2].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_vell.tres::reactions[2].beat_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_vell.tres::stages[0].idle_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_vell.tres::stages[1].beat_rules[0].dialogue.lines[0].speaker
#. key: data/arcs/arc_vell.tres::stages[1].beat_rules[0].dialogue.lines[1].speaker
#. key: data/arcs/arc_vell.tres::stages[1].idle_rules[1].dialogue.lines[0].speaker
#. key: data/npcs/vell.tres::display_name
#. key: data/npcs/vell.tres::rules[0].dialogue.lines[0].speaker
#. key: data/npcs/vell.tres::rules[0].dialogue.lines[1].speaker
#. key: data/npcs/vell.tres::rules[0].dialogue.lines[2].speaker
#. key: data/npcs/vell.tres::rules[1].dialogue.lines[0].speaker
#. DialogueLine · speaker: Vell
#. NpcProfile
#. max 24 chars
#: data/arcs/arc_vell.tres data/npcs/vell.tres
msgid "Vell"
msgstr ""

#. key: data/arcs/arc_vell.tres::stages[0].idle_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Vell
#. max 160 chars
#: data/arcs/arc_vell.tres
msgid "My best customer. I'm still not asking what you are."
msgstr ""

#. key: data/arcs/arc_vell.tres::stages[1].journal_note
#. NpcArcStage
#. max 90 chars
#: data/arcs/arc_vell.tres
msgid "Krail's supply line is dead. Vell isn't sorry, just short."
msgstr ""

#. key: data/arcs/arc_vell.tres::stages[1].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Vell
#. max 160 chars
#: data/arcs/arc_vell.tres
msgid "Krail's dead, so my supply line is too. His tower moved everything the Spire threw away."
msgstr ""

#. key: data/arcs/arc_vell.tres::stages[1].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Vell
#. max 160 chars
#: data/arcs/arc_vell.tres
msgid "Circuits come from somewhere. I never asked where. Don't you start."
msgstr ""

#. key: data/arcs/arc_vell.tres::stages[1].idle_rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Vell
#. max 160 chars
#: data/arcs/arc_vell.tres
msgid "Stock's thin since Krail. Capacity's still the only real currency."
msgstr ""

#. key: data/arcs/arc_vell.tres::reactions[0].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Vell
#. max 160 chars
#: data/arcs/arc_vell.tres
msgid "Your Core keeps making room. Most rigs cap out and start smoking."
msgstr ""

#. key: data/arcs/arc_vell.tres::reactions[0].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Vell
#. max 160 chars
#: data/arcs/arc_vell.tres
msgid "I'm not asking what you are. I'm writing it down."
msgstr ""

#. key: data/arcs/arc_vell.tres::reactions[1].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Vell
#. max 160 chars
#: data/arcs/arc_vell.tres
msgid "Orr's radio is back. Radios mean customers. I've put out the good stock."
msgstr ""

#. key: data/arcs/arc_vell.tres::reactions[2].beat_rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Vell
#. max 160 chars
#: data/arcs/arc_vell.tres
msgid "Krail's people asked me once about a Core that never caps out. Was I holding one."
msgstr ""

#. key: data/arcs/arc_vell.tres::reactions[2].beat_rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Vell
#. max 160 chars
#: data/arcs/arc_vell.tres
msgid "I said no. I say no a lot."
msgstr ""

#. key: data/challenges/br_collector.tres::title
#. ChallengeData
#. max 40 chars
#: data/challenges/br_collector.tres
msgid "Collector Drone — Rematch"
msgstr ""

#. key: data/challenges/br_collector.tres::description
#. ChallengeData
#. max 120 chars
#: data/challenges/br_collector.tres
msgid "The Collector Drone again, from the lift. The clock starts with the fight."
msgstr ""

#. key: data/challenges/br_collector_nohit.tres::title
#. ChallengeData
#. max 40 chars
#: data/challenges/br_collector_nohit.tres
msgid "Collector Drone — No Hit"
msgstr ""

#. key: data/challenges/br_collector_nohit.tres::description
#. ChallengeData
#. max 120 chars
#: data/challenges/br_collector_nohit.tres
