msgstr ""

#. key: data/sequences/ending_crown.tres::steps[2].text
#. SeqLine
#. max 120 chars
#: data/sequences/ending_crown.tres
msgid "You take hold of the network. Every light in Veyra steadies at once."
msgstr ""

#. key: data/sequences/ending_crown.tres::steps[3].text
#. SeqLine
#. max 120 chars
#: data/sequences/ending_crown.tres
msgid "The city runs through you now."
msgstr ""

#. key: data/sequences/ending_crown.tres::steps[4].text
#. SeqLine · speaker: nix
#. max 120 chars
#: data/sequences/ending_crown.tres
msgid "The map redraws itself every morning now. I don't touch it."
msgstr ""

#. key: data/sequences/ending_crown.tres::steps[6].subtitle
#. key: data/sequences/ending_redline.tres::steps[6].subtitle
#. key: data/sequences/ending_release.tres::steps[8].subtitle
#. key: data/sequences/ending_sever.tres::steps[9].subtitle
