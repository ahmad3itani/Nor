#. key: data/memories/mf_lowlight_01.tres::detail_text
#. MemorySceneData
#. max 120 chars
#: data/memories/mf_lowlight_01.tres
msgid "The order is signed. The signature is red static. It won't come into focus."
msgstr ""

#. key: data/memories/mf_lowlight_01.tres::beats[0].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mf_lowlight_01.tres
msgid "A voice reading numbers. Yours, you think."
msgstr ""

#. key: data/memories/mf_lowlight_01.tres::beats[1].speaker
#. key: data/memories/mf_lowlight_01.tres::beats[2].speaker
#. MemoryBeat · speaker: READER
#. max 24 chars
#: data/memories/mf_lowlight_01.tres
msgid "READER"
msgstr ""

#. key: data/memories/mf_lowlight_01.tres::beats[1].text
#. MemoryBeat · speaker: READER
#. max 160 chars
#: data/memories/mf_lowlight_01.tres
msgid "Subject non-viable."
msgstr ""

#. key: data/memories/mf_lowlight_01.tres::beats[2].text
#. MemoryBeat · speaker: READER
#. max 160 chars
#: data/memories/mf_lowlight_01.tres
msgid "Recover the core. Discard the rest."
msgstr ""

#. key: data/memories/mf_lowlight_01.tres::beats[3].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mf_lowlight_01.tres
msgid "The lights go out. Someone laughs."
msgstr ""

#. key: data/memories/mf_lowlight_02.tres::detail_text
#. MemorySceneData
#. max 120 chars
#: data/memories/mf_lowlight_02.tres
msgid "On the tray, a second dressing the shape of your scar. Already used."
msgstr ""

#. key: data/memories/mf_lowlight_02.tres::beats[0].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mf_lowlight_02.tres
msgid "Rain on a tin roof. A lamp with a green shade."
msgstr ""

#. key: data/memories/mf_lowlight_02.tres::beats[1].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mf_lowlight_02.tres
msgid "A hand on your chest, where the scar is now."
msgstr ""

#. key: data/memories/mf_lowlight_02.tres::beats[2].text
#. MemoryBeat · speaker: VOICE
#. max 160 chars
#: data/memories/mf_lowlight_02.tres
msgid "It runs on something it shouldn't."
msgstr ""

#. key: data/memories/mf_lowlight_02.tres::beats[3].text
#. MemoryBeat · speaker: VOICE
#. max 160 chars
#: data/memories/mf_lowlight_02.tres
msgid "Every time it spikes, you'll lose a little more of whatever it's eating."
msgstr ""

#. key: data/memories/mf_lowlight_03.tres::detail_text
#. MemorySceneData
#. max 120 chars
#: data/memories/mf_lowlight_03.tres
msgid "Your line in the ledger has no name. Only SPIRE, and a date the rain has smeared."
msgstr ""

#. key: data/memories/mf_lowlight_03.tres::beats[0].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mf_lowlight_03.tres
msgid "Lamplight on a steel desk. You see it from the floor."
msgstr ""

#. key: data/memories/mf_lowlight_03.tres::beats[1].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mf_lowlight_03.tres
msgid "Krail's handwriting, neat as a verdict:"
msgstr ""

#. key: data/memories/mf_lowlight_03.tres::beats[2].speaker
#. key: data/memories/mf_lowlight_03.tres::beats[3].speaker
#. MemoryBeat · speaker: LEDGER
#. max 24 chars
#: data/memories/mf_lowlight_03.tres
msgid "LEDGER"
msgstr ""

#. key: data/memories/mf_lowlight_03.tres::beats[2].text
#. MemoryBeat · speaker: LEDGER
#. max 160 chars
#: data/memories/mf_lowlight_03.tres
msgid "Everything pulled from the Spire passes through my tower. Everything."
msgstr ""

#. key: data/memories/mf_lowlight_03.tres::beats[3].text
#. MemoryBeat · speaker: LEDGER
#. max 160 chars
#: data/memories/mf_lowlight_03.tres
msgid "That includes the ones they call REDLINE."
msgstr ""

#. key: data/memories/mf_lowlight_04.tres::detail_text
#. MemorySceneData
#. max 120 chars
#: data/memories/mf_lowlight_04.tres
msgid "The tapping never finishes. Three short, three long, then nothing."
msgstr ""

#. key: data/memories/mf_lowlight_04.tres::beats[0].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mf_lowlight_04.tres
msgid "Rain through a crack in the ceiling."
msgstr ""

#. key: data/memories/mf_lowlight_04.tres::beats[1].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mf_lowlight_04.tres
msgid "Someone in the next cell taps the pipe: three short, three long."
msgstr ""

#. key: data/memories/mf_lowlight_04.tres::beats[2].speaker
#. key: data/memories/mf_lowlight_04.tres::beats[3].speaker
#. MemoryBeat · speaker: GUARD
#. max 24 chars
#: data/memories/mf_lowlight_04.tres
msgid "GUARD"
msgstr ""

#. key: data/memories/mf_lowlight_04.tres::beats[2].text
#. MemoryBeat · speaker: GUARD
#. max 160 chars
#: data/memories/mf_lowlight_04.tres
msgid "Save it."
msgstr ""

#. key: data/memories/mf_lowlight_04.tres::beats[3].text
#. MemoryBeat · speaker: GUARD
#. max 160 chars
#: data/memories/mf_lowlight_04.tres
msgid "This one came in without a name. The tag just says SPIRE."
msgstr ""

#. key: data/memories/mf_undercity_01.tres::detail_text
#. MemorySceneData
#. max 120 chars
#: data/memories/mf_undercity_01.tres
msgid "A tag on the tray: UNIT 14. CYCLE 4471. The name field is blank."
msgstr ""

#. key: data/memories/mf_undercity_01.tres::beats[0].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mf_undercity_01.tres
msgid "Cold steel under your back. A lamp swinging overhead."
msgstr ""

#. key: data/memories/mf_undercity_01.tres::beats[1].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mf_undercity_01.tres
msgid "Gloved hands on your chest, pulling. Something inside pulls back harder."
msgstr ""

#. key: data/memories/mf_undercity_01.tres::beats[2].speaker
#. MemoryBeat · speaker: CREW
#. max 24 chars
#: data/memories/mf_undercity_01.tres
msgid "CREW"
msgstr ""

#. key: data/memories/mf_undercity_01.tres::beats[2].text
#. MemoryBeat · speaker: CREW
#. max 160 chars
#: data/memories/mf_undercity_01.tres
msgid "It won't come out."
msgstr ""

#. key: data/memories/mf_undercity_01.tres::beats[3].speaker
#. MemoryBeat · speaker: SUPERVISOR
#. max 24 chars
#: data/memories/mf_undercity_01.tres
msgid "SUPERVISOR"
msgstr ""

#. key: data/memories/mf_undercity_01.tres::beats[3].text
#. MemoryBeat · speaker: SUPERVISOR
#. max 160 chars
#: data/memories/mf_undercity_01.tres
msgid "Then leave it in him. The Collector can take both."
msgstr ""

#. key: data/npcs/iko.tres::map_label
#. NpcProfile
#. max 24 chars
#: data/npcs/iko.tres
msgid "Black Market"
msgstr ""

#. key: data/npcs/iko.tres::verb
#. key: data/npcs/mara.tres::verb
#. key: data/npcs/nix.tres::verb
#. key: data/npcs/orr.tres::verb
#. key: data/npcs/vell.tres::verb
#. key: interactables/NPC.gd::l10n
#. NpcProfile
#. max 16 chars
#: data/npcs/iko.tres data/npcs/mara.tres data/npcs/nix.tres data/npcs/orr.tres data/npcs/vell.tres interactables/NPC.gd
msgid "Talk"
msgstr ""

#. key: data/npcs/iko.tres::rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Iko
#. max 160 chars
#: data/npcs/iko.tres
msgid "Easy. You're the one who lit up the grid? Good. Krail's people have been sitting on my canal for a month."
msgstr ""

#. key: data/npcs/iko.tres::rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Iko
#. max 160 chars
#: data/npcs/iko.tres
msgid "Iko. I move what the Wardens don't want moved. I'll set up somewhere safer. That Relay of yours."
msgstr ""

#. key: data/npcs/iko.tres::rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Iko
#. max 160 chars
#: data/npcs/iko.tres
msgid "Everything here fell off a Warden truck. Don't ask which one."
msgstr ""

#. key: data/npcs/mara.tres::map_label
#. NpcProfile
#. max 24 chars
#: data/npcs/mara.tres
msgid "Mechanic"
msgstr ""

#. key: data/npcs/mara.tres::rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/npcs/mara.tres
msgid "Orr says you walked out of a Collector's nest with that thing still burning in you."
msgstr ""

#. key: data/npcs/mara.tres::rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/npcs/mara.tres
msgid "You've felt it drink by now. Keep it fed, rest at Anchors, and it'll keep you running. Here. A Scattergun. Up close it solves arguments."
msgstr ""

#. key: data/npcs/mara.tres::rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/npcs/mara.tres
msgid "Stop poking the scar. That's a Redline Core, and it is not supposed to be in a person."
msgstr ""

#. key: data/npcs/mara.tres::rules[1].dialogue.lines[1].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/npcs/mara.tres
msgid "Out there it burns hot. Fight, move, break things - it drinks what's left and keeps you running."
msgstr ""

#. key: data/npcs/mara.tres::rules[1].dialogue.lines[2].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/npcs/mara.tres
msgid "Rest at an Anchor and it settles. Here. A Scattergun. Up close it solves arguments."
msgstr ""

#. key: data/npcs/mara.tres::rules[2].dialogue.lines[0].text
#. DialogueLine · speaker: Mara
#. max 160 chars
#: data/npcs/mara.tres
msgid "Weapons, fixes, bad advice. Pick one."
msgstr ""

#. key: data/npcs/nix.tres::rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/npcs/nix.tres
msgid "You walked it. All of it, near enough. Look at that - the flood lines, the new walls."
msgstr ""

#. key: data/npcs/nix.tres::rules[0].dialogue.lines[1].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/npcs/nix.tres
msgid "Seventy years of Lowlight and nobody bothered to redraw it. Here. Your cut, and my old lens."
msgstr ""

#. key: data/npcs/nix.tres::rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/npcs/nix.tres
msgid "Nix. I draw the city. The city keeps redrawing itself, so it's steady work."
msgstr ""

#. key: data/npcs/nix.tres::rules[1].dialogue.lines[1].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/npcs/nix.tres
msgid "Lowlight moved twice since the flood. My maps didn't. Walk it for me and I'll fill in the rest."
msgstr ""

#. key: data/npcs/nix.tres::rules[1].dialogue.lines[2].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/npcs/nix.tres
msgid "Take a look at the stock. The transit pass gets you between Anchors you've rested at."
msgstr ""

#. key: data/npcs/nix.tres::rules[2].dialogue.lines[0].text
#. DialogueLine · speaker: Nix
#. max 160 chars
#: data/npcs/nix.tres
msgid "Maps, lenses, tickets. Everything a lost person needs."
msgstr ""

#. key: data/npcs/orr.tres::map_label
#. key: data/npcs/orr_radio.tres::display_name
#. key: data/npcs/orr_radio.tres::map_label
#. key: data/npcs/orr_radio.tres::rules[1].dialogue.lines[0].speaker
#. key: data/npcs/orr_radio.tres::rules[1].dialogue.lines[1].speaker
#. key: data/npcs/orr_radio.tres::rules[2].dialogue.lines[0].speaker
#. key: data/npcs/orr_radio.tres::rules[5].dialogue.lines[0].speaker
#. key: data/npcs/orr_radio.tres::rules[5].dialogue.lines[1].speaker
#. key: data/npcs/orr_radio.tres::rules[5].dialogue.lines[2].speaker
#. key: data/npcs/orr_radio.tres::rules[5].dialogue.lines[3].speaker
#. key: data/npcs/orr_radio.tres::rules[5].dialogue.lines[4].speaker
#. key: data/npcs/orr_radio.tres::rules[6].dialogue.lines[0].speaker
#. key: data/npcs/orr_radio.tres::rules[6].dialogue.lines[1].speaker
#. key: data/npcs/orr_radio.tres::rules[6].dialogue.lines[2].speaker
#. DialogueLine · speaker: Radio
#. NpcProfile
#. max 24 chars
#: data/npcs/orr.tres data/npcs/orr_radio.tres
msgid "Radio"
msgstr ""

#. key: data/npcs/orr.tres::rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr.tres
msgid "A smuggler came up the lift while you were out. Iko. Says you're good for business."
msgstr ""

#. key: data/npcs/orr.tres::rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr.tres
msgid "Somebody lit up the Rainline. My whole board just jumped."
msgstr ""

#. key: data/npcs/orr.tres::rules[2].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr.tres
msgid "All three? The static's gone. I can hear Warden Krail's patrol codes clear as rain."
msgstr ""

#. key: data/npcs/orr.tres::rules[2].dialogue.lines[1].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr.tres
msgid "He's pulling something up the Bell Tower lift every night. Same crates they meant to carry you out in."
msgstr ""

#. key: data/npcs/orr.tres::rules[2].dialogue.lines[2].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr.tres
msgid "Take this. Earned it. And Rook - don't go up that tower tired."
msgstr ""

#. key: data/npcs/orr.tres::rules[3].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr.tres
msgid "So you're the one who shut a Collector up. You look worse than I pictured."
msgstr ""

#. key: data/npcs/orr.tres::rules[3].dialogue.lines[1].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr.tres
msgid "Mara wants a look at that Core. First, though: the Warden's people knocked our repeaters out of line."
msgstr ""

#. key: data/npcs/orr.tres::rules[3].dialogue.lines[2].text
#. key: data/npcs/orr.tres::rules[4].dialogue.lines[2].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr.tres
msgid "Lowlight's full of them. Realign three and this whole Relay stops being deaf. Deal?"
msgstr ""

#. key: data/npcs/orr.tres::rules[4].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr.tres
msgid "You're awake. Good. Mara said the thing in your chest would either restart you or cook the room."
msgstr ""

#. key: data/npcs/orr.tres::rules[4].dialogue.lines[1].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr.tres
msgid "I run the radio. Or I did, before the Warden's people knocked our repeaters out of line."
msgstr ""

#. key: data/npcs/orr_radio.tres::verb
#. key: data/npcs/relay_board.tres::verb
#. NpcProfile
#. max 16 chars
#: data/npcs/orr_radio.tres data/npcs/relay_board.tres
msgid "Listen"
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[0].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "Relay here. Nothing on this band but Recovery now. Don't linger."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[1].dialogue.lines[0].text
#. DialogueLine · speaker: Radio
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "The Collector's gone off the band. Tell me that was you."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[1].dialogue.lines[1].text
#. DialogueLine · speaker: Radio
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "Rail line's straight ahead. Top gallery, left side of the Relay. I'll leave the door unjammed."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[2].dialogue.lines[0].text
#. DialogueLine · speaker: Radio
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "Top gallery. Keep climbing."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[3].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "Orr, on the old crew band. You came down the back way? Then you know the voice."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[3].dialogue.lines[1].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "That bay below you is a Collector's nest. It hunts what's in your chest. Don't stand still near it."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[4].dialogue.lines[0].text
#. DialogueLine · speaker: Orr
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "Lift shaft, then the Anchor at the top, then the Collector's bay. Don't stop moving."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[5].dialogue.lines[0].text
#. DialogueLine · speaker: Radio
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "...is this band live? You by the lift shaft - don't answer. Just listen."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[5].dialogue.lines[1].text
#. DialogueLine · speaker: Radio
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "That eye was a Collector. Civic Recovery. It doesn't want you. It wants what's in your chest."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[5].dialogue.lines[2].text
#. DialogueLine · speaker: Radio
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "Up the shaft the Pulse runs thick and your Core drains. Keep moving, keep hitting. It feeds on that."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[5].dialogue.lines[3].text
#. DialogueLine · speaker: Radio
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "There's an Anchor at the top - our kit. Rest there and fill back up. The only way on is through the bay. Its nest."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[5].dialogue.lines[4].text
#. DialogueLine · speaker: Radio
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "Get past it and follow the old rail line up to the Relay. We're friendly. Mostly. Name's Orr."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[6].dialogue.lines[0].text
#. DialogueLine · speaker: Radio
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "...is this band live? Don't answer. Just listen."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[6].dialogue.lines[1].text
#. DialogueLine · speaker: Radio
#. max 160 chars
#: data/npcs/orr_radio.tres
msgid "Something down here hunts what's in your chest. Civic Recovery calls it a Collector. Its nest is the bay under the old rail line."
msgstr ""

#. key: data/npcs/orr_radio.tres::rules[6].dialogue.lines[2].text
#. DialogueLine · speaker: Radio
