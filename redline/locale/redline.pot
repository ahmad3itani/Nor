#. key: data/lore/mf_lowlight_01.tres::title
#. MemoryFragmentData
#. max 40 chars
#: data/lore/mf_lowlight_01.tres
msgid "Execution Order 7-R"
msgstr ""

#. key: data/lore/mf_lowlight_01.tres::text
#. MemoryFragmentData
#. max 240 chars
#: data/lore/mf_lowlight_01.tres
msgid "A voice reading numbers. Yours, you think. \"Subject non-viable. Recover the core. Discard the rest.\" Someone laughed when the lights went out."
msgstr ""

#. key: data/lore/mf_lowlight_02.tres::title
#. MemoryFragmentData
#. max 40 chars
#: data/lore/mf_lowlight_02.tres
msgid "Rain Clinic"
msgstr ""

#. key: data/lore/mf_lowlight_02.tres::text
#. MemoryFragmentData
#. max 240 chars
#: data/lore/mf_lowlight_02.tres
msgid "A hand on your chest, where the scar is now. \"It runs on something it shouldn't. Every time it spikes, you'll lose a little more of whatever it's eating.\""
msgstr ""

#. key: data/lore/mf_lowlight_03.tres::title
#. MemoryFragmentData
#. max 40 chars
#: data/lore/mf_lowlight_03.tres
msgid "The Warden's Ledger"
msgstr ""

#. key: data/lore/mf_lowlight_03.tres::text
#. MemoryFragmentData
#. max 240 chars
#: data/lore/mf_lowlight_03.tres
msgid "Krail's handwriting, neat as a verdict: \"Everything pulled from the Spire passes through my tower. Everything. That includes the ones they call REDLINE.\""
msgstr ""

#. key: data/lore/mf_lowlight_04.tres::title
#. MemoryFragmentData
#. max 40 chars
#: data/lore/mf_lowlight_04.tres
msgid "Cell Four"
msgstr ""

#. key: data/lore/mf_lowlight_04.tres::text
#. MemoryFragmentData
#. max 240 chars
#: data/lore/mf_lowlight_04.tres
msgid "Rain through a crack in the ceiling. Someone in the next cell taps the pipe: three short, three long. A guard laughs. \"Save it. This one came in without a name. The tag just says SPIRE.\""
msgstr ""

#. key: data/lore/mf_undercity_01.tres::title
#. MemoryFragmentData
#. max 40 chars
#: data/lore/mf_undercity_01.tres
msgid "It Won't Come Out"
msgstr ""

#. key: data/lore/mf_undercity_01.tres::text
#. MemoryFragmentData
#. max 240 chars
#: data/lore/mf_undercity_01.tres
msgid "Cold steel under your back. Gloved hands on your chest, pulling. Something inside pulls back harder. \"It won't come out.\" A long pause. \"Then leave it in him. The Collector can take both.\""
msgstr ""

#. key: data/memories/mem_first_rest.tres::title
#. MemorySceneData
#. max 40 chars
#: data/memories/mem_first_rest.tres
msgid "Count the Last One"
msgstr ""

#. key: data/memories/mem_first_rest.tres::detail_text
#. MemorySceneData
#. max 120 chars
#: data/memories/mem_first_rest.tres
msgid "The last car has no markings. Its doors are welded shut."
msgstr ""

#. key: data/memories/mem_first_rest.tres::beats[0].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mem_first_rest.tres
msgid "Night. A bridge over the rail yards. Wind in the railings."
msgstr ""

#. key: data/memories/mem_first_rest.tres::beats[1].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mem_first_rest.tres
msgid "Someone beside you counts the cars under their breath."
msgstr ""

#. key: data/memories/mem_first_rest.tres::beats[2].speaker
#. key: data/memories/mf_lowlight_02.tres::beats[2].speaker
#. key: data/memories/mf_lowlight_02.tres::beats[3].speaker
#. MemoryBeat · speaker: VOICE
#. max 24 chars
#: data/memories/mem_first_rest.tres data/memories/mf_lowlight_02.tres
msgid "VOICE"
msgstr ""

#. key: data/memories/mem_first_rest.tres::beats[2].text
#. MemoryBeat · speaker: VOICE
#. max 160 chars
#: data/memories/mem_first_rest.tres
msgid "Always count the last one twice."
msgstr ""

#. key: data/memories/mem_first_rest.tres::beats[3].text
#. MemoryBeat
#. max 160 chars
#: data/memories/mem_first_rest.tres
msgid "You turn to ask why. Where their face should be, there's only static."
msgstr ""

#. key: data/memories/memory_config.tres::title_label
#. MemoryConfig
#. max 24 chars
#: data/memories/memory_config.tres
msgid "MEMORY"
msgstr ""

#. key: data/memories/memory_config.tres::card_body_anchor
#. MemoryConfig
#. max 60 chars
#: data/memories/memory_config.tres
