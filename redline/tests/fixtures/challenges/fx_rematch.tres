[gd_resource type="Resource" script_class="ChallengeData" load_steps=4 format=3]

[ext_resource type="Script" path="res://challenges/ChallengeData.gd" id="1_data"]
[ext_resource type="Script" path="res://challenges/ChallengeKit.gd" id="2_kit"]

[sub_resource type="Resource" id="Resource_kit"]
script = ExtResource("2_kit")
melee = "pulse_blade"
set_flags = PackedStringArray("got_pulse_blade")
clear_flags = PackedStringArray("collector_drone_defeated", "got_service_pistol")

[resource]
script = ExtResource("1_data")
id = "fx_rematch"
group = 1
title = "Fixture Rematch"
description = "The Collector Drone again, from the lift."
locked_hint = "Defeat the Collector Drone."
unlock_when = "flag:collector_drone_defeated"
start_room = "res://world/rooms/undercity/CollectorBay.tscn"
start_entry = &"from_lift"
kit = SubResource("Resource_kit")
start_on = 2
end_on = 1
boss_id = "collector_drone"
medal_thresholds = PackedInt32Array(5400, 3600, 2400, 1800)
dev_bot = &"boss_blade"
