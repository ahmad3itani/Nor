[gd_resource type="Resource" script_class="SplitList" load_steps=6 format=3]

[ext_resource type="Script" path="res://challenges/SplitList.gd" id="1_list"]
[ext_resource type="Script" path="res://challenges/SplitDef.gd" id="2_def"]

[sub_resource type="Resource" id="Resource_a"]
script = ExtResource("2_def")
id = "fx_a"
label = "Split A"
when = "flag:fx_split_a"

[sub_resource type="Resource" id="Resource_b"]
script = ExtResource("2_def")
id = "fx_b"
label = "Split B"
when = "flag:fx_split_b"

[sub_resource type="Resource" id="Resource_end"]
script = ExtResource("2_def")
id = "act1_end"
label = "Act I"
when = "flag:fx_split_end"

[resource]
script = ExtResource("1_list")
splits = Array[ExtResource("2_def")]([SubResource("Resource_a"), SubResource("Resource_b"), SubResource("Resource_end")])
